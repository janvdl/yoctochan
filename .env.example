# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# read automatically by config/settings/base.py; anything left unset here
# falls back to the (insecure, dev-only) defaults in base.py. Real
# environment variables always take precedence over `.env`.
#
# None of this is required for `python manage.py runserver` — it exists for
# deployments running config.settings.prod (DJANGO_SETTINGS_MODULE=config.settings.prod),
# which refuses to start until the required values below are set.

# --- Core ---

# Required in production. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# true/false. Defaults to true (dev). Production must set this to false.
DJANGO_DEBUG=false

# Comma-separated hostnames this site is served as, e.g. example.com,www.example.com
# Required (non-empty) in production.
DJANGO_ALLOWED_HOSTS=

# --- Database ---
# DATABASE_ENGINE=sqlite3 (default) or postgresql. Using the deploy/
# compose stack? It sets DATABASE_ENGINE and POSTGRES_HOST for you
# (docker-compose.yml) — you only need POSTGRES_DB/USER/PASSWORD here,
# which the db container also reads to initialise itself.

DATABASE_ENGINE=postgresql
POSTGRES_DB=yoctochan
POSTGRES_USER=yoctochan
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Misc ---

# Set to true only when running behind a reverse proxy that sets
# trustworthy X-Forwarded-For / X-Forwarded-Proto headers (the deploy/
# compose stack's Caddy does; it sets this for you).
TRUST_X_FORWARDED_FOR=false

# See https://docs.djangoproject.com/en/6.1/topics/email/
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- deploy/ compose stack only ---

# Hostname Caddy serves as. Leave unset (defaults to "localhost") until you
# have a real domain's DNS pointed at this host with 80/443 reachable —
# Caddy then automatically gets and renews a real Let's Encrypt
# certificate for it instead of a locally-trusted one. Should match (or be
# included in) DJANGO_ALLOWED_HOSTS above.
DOMAIN=
